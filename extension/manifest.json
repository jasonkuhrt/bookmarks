{
  "manifest_version": 3,
  "name": "Bookmarks CLI",
  "version": "0.1.0",
  "description": "Connects the bookmarks CLI to this Chrome profile.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "key": "",
  "permissions": ["bookmarks", "readingList", "nativeMessaging", "storage", "alarms"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  }
}
