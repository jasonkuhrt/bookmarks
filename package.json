{
  "name": "@jasonkuhrt/bookmarks",
  "version": "0.0.0",
  "description": "Cross-browser bookmark sync driven by ~/.config/bookmarks/bookmarks.yaml",
  "homepage": "https://github.com/jasonkuhrt/bookmarks",
  "bugs": {
    "url": "https://github.com/jasonkuhrt/bookmarks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jasonkuhrt/bookmarks.git"
  },
  "bin": {
    "bookmarks": "./src/bin/bookmarks.ts"
  },
  "files": [
    "build",
    "extension",
    "README.md",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./build/exports/index.js"
  },
  "scripts": {
    "generate:icons": "bash scripts/generate-icons.sh",
    "build:chrome-extension": "bun scripts/build-chrome-extension.ts",
    "build:clean": "tsrs --build --clean && rm -rf build",
    "prebuild": "bun run build:clean",
    "build": "tsrs --build tsconfig.build.json",
    "test": "bun test src extension",
    "test:integration": "bun test src/bin/bookmarks.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir coverage",
    "prepack": "bun run build && bun scripts/prepack-imports.ts",
    "postpack": "bun scripts/prepack-imports.ts --restore",
    "fix": "bun run fix:format && bun run fix:lint",
    "fix:format": "oxfmt --write",
    "fix:lint": "OXLINT_TSGOLINT_PATH=./node_modules/.bin/tsrs-lint oxlint --type-aware --fix-dangerously --deny-warnings",
    "check": "bun run check:format && bun run check:lint && bun run check:types && bun run test && bun run check:package && bun run check:exports && bun run check:ci",
    "check:format": "oxfmt --check",
    "check:lint": "OXLINT_TSGOLINT_PATH=./node_modules/.bin/tsrs-lint oxlint --type-aware --report-unused-disable-directives --deny-warnings",
    "check:types": "tsrs --noEmit --fast",
    "check:package": "bun run build && publint run --strict",
    "check:exports": "attw --pack . --profile esm-only",
    "check:ci": "actionlint",
    "bookmarks": "bun src/bin/bookmarks.ts",
    "generate:json-schema": "bun src/lib/generate-json-schema.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@plist/binary.parse": "^1.1.0",
    "@plist/binary.serialize": "^1.1.0",
    "effect": "^3.12.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "^1.3.10",
    "@types/node": "25.3.5",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.36.0",
    "oxlint": "1.51.0",
    "publint": "^0.3.18",
    "tsrs": "0.23.0-ts7.1.0-beta"
  }
}
